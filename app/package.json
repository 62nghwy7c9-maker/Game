{
  "name": "wochenkompass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:offline": "vite build -c vite.singlefile.config.ts && mv ../docs/offline/index.html ../docs/offline/wochenkompass.html",
